📄 pvc.yaml

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc-storage
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: manual
  resources:
    requests:
      storage: 1Gi

📄 pod-pvc.yaml

apiVersion: v1
kind: Pod
metadata:
  name: pvc-pod
spec:
  containers:
    - name: mario-container
      image: harshalgit/super-mario
      ports:
        - containerPort: 80
      volumeMounts:
        - name: app-storage
          mountPath: /usr/share/nginx/html
  volumes:
    - name: app-storage
      persistentVolumeClaim:
        claimName: pvc-storage

Commands

kubectl apply -f pv.yaml

kubectl apply -f pvc.yaml

kubectl apply -f pod-pvc.yaml

kubectl get pv

kubectl get pvc

kubectl get pods

kubectl describe pvc pvc-storage

kubectl describe pod pvc-pod
